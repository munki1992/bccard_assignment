<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상 - 앱 데이터(좋아요 DB · 오프라인 이미지 등)를 클라우드 백업 · 기기 간 이전에서 모두 제외 -->
<data-extraction-rules>

    <cloud-backup>
        <exclude domain="root" path="." />          <!-- 앱 내부 저장소 -->
        <exclude domain="external" path="." />      <!-- 앱 외부 저장소 -->
        <exclude domain="device_root" path="." />   <!-- 기기 저장소 -->
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />          <!-- 앱 내부 저장소 -->
        <exclude domain="external" path="." />      <!-- 앱 외부 저장소 -->
        <exclude domain="device_root" path="." />   <!-- 기기 저장소 -->
    </device-transfer>

</data-extraction-rules>