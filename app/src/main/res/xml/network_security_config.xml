<?xml version="1.0" encoding="utf-8"?>
<!-- 평문(HTTP) 통신 금지 - HTTPS 만 허용, 시스템 인증서만 신뢰 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>