default_platform(:android)

platform :android do
  desc "[검사] 코드를 바꿀 때마다 실행 — baseline 에 없는 새 이슈가 있으면 실패 (보안 항목은 fatal)"
  lane :lint do
    gradle(task: ":app:lintDebug")
  end

  desc "[정리] baseline 에 있던 이슈를 고쳤을 때만 실행 — 먼저 lint 로 새 이슈가 없는지 확인할 것"
  lane :lint_baseline do
    gradle(task: ":app:updateLintBaseline")
  end

  desc "[의존성 검증] 라이브러리를 추가하거나 버전을 올렸을 때 실행 — gradle/verification-metadata.xml 의 지문(SHA-256) 갱신"
  lane :verification_metadata do
    gradle(
      tasks: ["help", ":app:assembleDebug", ":app:assembleRelease", ":app:lintRelease", ":app:lintDebug", "testDebugUnitTest", ":app:assembleDebugAndroidTest", ":baselineprofile:assembleNonMinifiedRelease", ":baselineprofile:assembleBenchmarkRelease"],
      flags: "--write-verification-metadata sha256 --refresh-dependencies"
    )

    # IDE(Android Studio) Sync 가 받는 소스 · javadoc · Gradle 소스(src.zip) 는 앱에 들어가지 않으므로 검증 예외 — 파일을 새로 만들어도 빠진 규칙만 자동으로 채운다
    metadata = File.expand_path("../gradle/verification-metadata.xml", __dir__)
    xml = File.read(metadata)
    rules = [
      "<trust file=\".*-javadoc[.]jar\" regex=\"true\"/>",
      "<trust file=\".*-sources[.]jar\" regex=\"true\"/>",
      "<trust group=\"gradle\" name=\"gradle\"/>"
    ]
    missing = rules.reject { |rule| xml.include?(rule) }
    unless missing.empty?
      lines = missing.map { |rule| "         #{rule}" }.join("\n")
      xml = if xml.include?("</trusted-artifacts>")
        xml.sub("      </trusted-artifacts>", "#{lines}\n      </trusted-artifacts>")
      else
        xml.sub("   </configuration>", "      <trusted-artifacts>\n#{lines}\n      </trusted-artifacts>\n   </configuration>")
      end
      File.write(metadata, xml)
      UI.message("verification-metadata.xml 에 신뢰 규칙 #{missing.size}개 추가")
    end

    # github dependabot.yml
    # aapt2 는 OS 마다 다른 jar(osx · linux · windows)를 받는다 — 이 PC 에서 받은 것만 기록되므로 나머지 OS 지문을 Google Maven 에서 받아 채운다 (CI 는 linux)
    # aapt2 -> Android Asset Packaging Tool 2. Android 앱의 리소스(res 폴더)를 처리해서 APK에 넣을 수 있는 형태로 바꿔 주는 프로그램
    require "net/http"
    require "digest"
    xml = File.read(metadata)
    added = 0
    xml.scan(/<component group="com\.android\.tools\.build" name="aapt2" version="([^"]+)">/).flatten.uniq.each do |version|
      %w[osx linux windows].each do |os|
        jar = "aapt2-#{version}-#{os}.jar"
        next if xml.include?("<artifact name=\"#{jar}\">")
        url = URI("https://dl.google.com/dl/android/maven2/com/android/tools/build/aapt2/#{version}/#{jar}")
        response = Net::HTTP.get_response(url)
        UI.user_error!("#{jar} 다운로드 실패 (HTTP #{response.code})") unless response.is_a?(Net::HTTPSuccess)
        sha256 = Digest::SHA256.hexdigest(response.body)
        entry = "         <artifact name=\"#{jar}\">\n            <sha256 value=\"#{sha256}\" origin=\"Generated by fastlane (Google Maven)\"/>\n         </artifact>\n"
        component = "<component group=\"com.android.tools.build\" name=\"aapt2\" version=\"#{version}\">\n"
        xml = xml.sub(component, component + entry)
        added += 1
      end
    end
    if added > 0
      File.write(metadata, xml)
      UI.message("verification-metadata.xml 에 aapt2 OS별 지문 #{added}개 추가")
    end
  end

  desc "[성능] Baseline Profile 생성 — 연결된 실기기(Android 13 이상)에서 앱을 자동 조작해 자주 쓰는 코드를 기록 (app/src/release/generated/baselineProfiles)"
  lane :baseline_profile do
    gradle(task: ":app:generateBaselineProfile")

    # 결과 확인 — 난독화된 이름(예: Lbb;)이 많으면 nonMinifiedRelease 에 R8 이 적용된 것 (app/build.gradle.kts 의 finalizeDsl 확인)
    profile = File.expand_path("../app/src/release/generated/baselineProfiles/baseline-prof.txt", __dir__)
    UI.user_error!("baseline-prof.txt 가 생성되지 않았습니다") unless File.exist?(profile)
    lines = File.readlines(profile)
    obfuscated = lines.count { |line| line.match?(/^[HSP]*L[a-z]{1,3}[0-9]*;/) }
    UI.message("baseline-prof.txt : #{lines.size}줄 (앱 #{lines.count { |line| line.include?("Lcom/bccard/munki/") }}줄, 난독화 이름 #{obfuscated}줄)")
    UI.important("난독화된 이름이 많습니다 — nonMinifiedRelease 의 R8 설정을 확인하세요") if obfuscated > lines.size / 2
  end

  desc "[성능] 시작 시간 비교 — 프로파일 없음 vs Baseline Profile 적용, 콜드 스타트 각 10회 측정 (baseline_profile 먼저 실행)"
  lane :startup_benchmark do
    gradle(task: ":baselineprofile:connectedBenchmarkReleaseAndroidTest")

    # 결과(benchmarkData.json)에서 테스트별 시작 시간(timeToInitialDisplayMs) 중간값 출력
    require "json"
    results = Dir.glob(File.expand_path("../baselineprofile/build/outputs/connected_android_test_additional_output/**/*benchmarkData.json", __dir__))
    UI.user_error!("벤치마크 결과(benchmarkData.json)를 찾을 수 없습니다") if results.empty?
    medians = {}
    JSON.parse(File.read(results.max_by { |file| File.mtime(file) }))["benchmarks"].each do |benchmark|
      metric = benchmark.dig("metrics", "timeToInitialDisplayMs")
      next unless metric
      medians[benchmark["name"]] = metric["median"]
      UI.message("#{benchmark["name"]} : 중간값 #{metric["median"].round(1)}ms (최소 #{metric["minimum"].round(1)} · 최대 #{metric["maximum"].round(1)}, #{metric["runs"].size}회)")
    end

    # 프로파일 없음 대비 Baseline Profile 적용 시 시작 시간 개선 (중간값 기준)
    none = medians["startupCompilationNone"]
    profile = medians["startupCompilationBaselineProfiles"]
    if none && profile
      UI.success("Baseline Profile 적용 → 콜드 스타트 #{(none - profile).round(1)}ms 단축 (#{((none - profile) / none * 100).round(1)}% 개선, #{none.round(1)}ms → #{profile.round(1)}ms)")
    end
  end
end